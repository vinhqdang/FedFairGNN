\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Honest runs ($K=5$): test AUC and soft DPD (lower is fairer), mean$\pm $sd over 10 seeds. Baselines and CLAMP (sums channel) use the same seeds and splits, with the output-rule warm-up applied; CLAMP used $P=1$ on Bail, Credit, Pokec-z, Pokec-n and AMiner-S and $P=10$ on German, NBA and Facebook, whereas CLAMP-RT uses $P=10$ everywhere. $^{c}$: reads per-client fairness quantities or group rates in the clear. PUFFLE and FedFDP barely learn at their privacy level (AUC near 0.5).}}{19}{table.2}\protected@file@percent }
\newlabel{tab:e1}{{2}{19}{Honest runs ($K=5$): test AUC and soft DPD (lower is fairer), mean$\pm $sd over 10 seeds. Baselines and CLAMP (sums channel) use the same seeds and splits, with the output-rule warm-up applied; CLAMP used $P=1$ on Bail, Credit, Pokec-z, Pokec-n and AMiner-S and $P=10$ on German, NBA and Facebook, whereas CLAMP-RT uses $P=10$ everywhere. $^{c}$: reads per-client fairness quantities or group rates in the clear. PUFFLE and FedFDP barely learn at their privacy level (AUC near 0.5)}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Statistics channel of CLAMP-RT in the honest runs ($K=5$, $b=1$, $\varepsilon =8$, $R=10$ releases, 10 seeds). $n_{0,\min }$ and $\sigma _d$: range over seeds. Radius: $\sqrt  {\tau ^2+2\sigma _d^2}+r_R$ of Theorem~\ref {thm:output} at the median $\sigma _d$ and $\beta =0.05$ (vacuous when $\ge 1$). $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle D$}\mathaccent "0362{D}>0$: share of releases with a non-zero bias-corrected magnitude. $\lambda ^T$: mean final multiplier. Right block: mean test DPD and AUC of CLAMP (sums channel) and CLAMP-RT, with the two-sided Wilcoxon signed-rank $p$-value paired by seed, Holm-adjusted across the eight datasets per metric.}}{20}{table.3}\protected@file@percent }
\newlabel{tab:channel}{{3}{20}{Statistics channel of CLAMP-RT in the honest runs ($K=5$, $b=1$, $\varepsilon =8$, $R=10$ releases, 10 seeds). $n_{0,\min }$ and $\sigma _d$: range over seeds. Radius: $\sqrt {\tau ^2+2\sigma _d^2}+r_R$ of Theorem~\ref {thm:output} at the median $\sigma _d$ and $\beta =0.05$ (vacuous when $\ge 1$). $\Dhat >0$: share of releases with a non-zero bias-corrected magnitude. $\lambda ^T$: mean final multiplier. Right block: mean test DPD and AUC of CLAMP (sums channel) and CLAMP-RT, with the two-sided Wilcoxon signed-rank $p$-value paired by seed, Holm-adjusted across the eight datasets per metric}{table.3}{}}
